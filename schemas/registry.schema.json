{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/schemas/registry/v1.json",
  "title": "simai.io product registry",
  "description": "Every product family and product the portal presents. Navigation, the home sections and sitemap.xml are generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "default_locale",
    "locales",
    "families",
    "products"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "simai.io.registry"
    },
    "version": {
      "const": 1
    },
    "default_locale": {
      "$ref": "#/$defs/locale"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "status"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/locale"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "live",
              "planned"
            ]
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "status",
          "title",
          "summary"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/$",
            "description": "Path under the locale prefix that the family's products live under, e.g. framework/ → /ru/framework/effects/. The path itself sends the reader to the family's section of the home page."
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "kind",
          "status",
          "title",
          "summary",
          "repository",
          "placement"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "family": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "docs",
              "catalogue",
              "app",
              "repository",
              "standard",
              "tool",
              "service"
            ]
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "repository": {
            "description": "Public GitHub repository owner/name, or null when the repository is not public.",
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "placement": {
            "$ref": "#/$defs/placement"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[0-9A-Za-z.]+)?$",
            "description": "The released version the card names, for a standard or a format."
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "status": {
      "enum": [
        "stable",
        "beta",
        "soon"
      ]
    },
    "text": {
      "type": "object",
      "description": "Text per locale; every live locale is required (checked by scripts/check.mjs).",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "planned_path": {
      "type": "string",
      "pattern": "^\\{locale\\}/[a-z0-9/-]+/$"
    },
    "placement": {
      "description": "Where the product lives now. external: another site, linked out until it is assembled into the portal. assembled: a release artifact the hub unpacks under path. subdomain: an application on its own origin. none: no public address yet.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "url"
          ],
          "properties": {
            "mode": {
              "const": "external"
            },
            "url": {
              "$ref": "#/$defs/url"
            },
            "planned": {
              "$ref": "#/$defs/planned_path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path"
          ],
          "properties": {
            "mode": {
              "const": "assembled"
            },
            "path": {
              "$ref": "#/$defs/planned_path"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "url"
          ],
          "properties": {
            "mode": {
              "const": "subdomain"
            },
            "url": {
              "type": "string",
              "pattern": "^https://[a-z0-9-]+\\.simai\\.io/$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "none"
            },
            "planned": {
              "$ref": "#/$defs/url"
            }
          }
        }
      ]
    }
  }
}
