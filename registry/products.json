{
  "$schema": "../schemas/registry.schema.json",
  "schema": "simai.io.registry",
  "version": 1,
  "default_locale": "ru",
  "locales": [
    {
      "id": "ru",
      "label": "Русский",
      "status": "live"
    },
    {
      "id": "en",
      "label": "English",
      "status": "live"
    }
  ],
  "families": [
    {
      "id": "framework",
      "path": "framework/",
      "status": "stable",
      "title": {
        "ru": "Framework",
        "en": "Framework"
      },
      "summary": {
        "ru": "Фронтенд-фреймворк SIMAI: ядро, утилиты, компоненты и смарт-компоненты для сайтов и интерфейсов.",
        "en": "The SIMAI front-end framework: core, utilities, components and smart components for sites and interfaces."
      }
    },
    {
      "id": "docara",
      "path": "docara/",
      "status": "stable",
      "title": {
        "ru": "Docara",
        "en": "Docara"
      },
      "summary": {
        "ru": "Генератор сайтов документации из Markdown на компонентах SIMAI Framework.",
        "en": "Documentation sites from Markdown, built with SIMAI Framework components."
      }
    }
  ],
  "products": [
    {
      "id": "framework-docs",
      "family": "framework",
      "kind": "docs",
      "status": "stable",
      "title": {
        "ru": "Документация",
        "en": "Documentation"
      },
      "summary": {
        "ru": "Руководство и справочник: утилиты, компоненты, раскладки, темы.",
        "en": "Guide and reference: utilities, components, layouts, themes."
      },
      "repository": "simai/ui-doc",
      "placement": {
        "mode": "external",
        "url": "https://simai.github.io/ui-doc/",
        "planned": "{locale}/framework/docs/"
      }
    },
    {
      "id": "framework-effects",
      "family": "framework",
      "kind": "catalogue",
      "status": "beta",
      "title": {
        "ru": "Фоновые эффекты",
        "en": "Background effects"
      },
      "summary": {
        "ru": "Каталог анимированных фонов с живым примером, настройками и кодом подключения.",
        "en": "A catalogue of animated backgrounds with a live preview, settings and embed code."
      },
      "repository": "simai/ui-effects",
      "placement": {
        "mode": "assembled",
        "path": "{locale}/framework/effects/"
      }
    },
    {
      "id": "framework-playground",
      "family": "framework",
      "kind": "app",
      "status": "beta",
      "title": {
        "ru": "Плейграунд",
        "en": "Playground"
      },
      "summary": {
        "ru": "Интерактивная песочница: компоненты, состояния и темы в браузере.",
        "en": "An interactive sandbox: components, states and themes in the browser."
      },
      "repository": null,
      "placement": {
        "mode": "subdomain",
        "url": "https://play.simai.io/"
      }
    },
    {
      "id": "framework-studio",
      "family": "framework",
      "kind": "app",
      "status": "soon",
      "title": {
        "ru": "Студия смарт-процессов",
        "en": "Smart process studio"
      },
      "summary": {
        "ru": "Сборка и проверка смарт-компонентов и процессов без кода.",
        "en": "Build and check smart components and processes without code."
      },
      "repository": null,
      "placement": {
        "mode": "none",
        "planned": "https://studio.simai.io/"
      }
    },
    {
      "id": "framework-themes",
      "family": "framework",
      "kind": "app",
      "status": "soon",
      "title": {
        "ru": "Настройка тем",
        "en": "Theme editor"
      },
      "summary": {
        "ru": "Редактор цветовых схем, шрифтов и размеров с экспортом темы.",
        "en": "Edit colour schemes, fonts and sizes, and export the theme."
      },
      "repository": null,
      "placement": {
        "mode": "none",
        "planned": "https://themes.simai.io/"
      }
    },
    {
      "id": "framework-admin",
      "family": "framework",
      "kind": "app",
      "status": "soon",
      "title": {
        "ru": "Админка",
        "en": "Admin"
      },
      "summary": {
        "ru": "Эталонный интерфейс администрирования на SIMAI Framework.",
        "en": "The reference administration interface built with SIMAI Framework."
      },
      "repository": null,
      "placement": {
        "mode": "none",
        "planned": "https://admin.simai.io/"
      }
    },
    {
      "id": "framework-source",
      "family": "framework",
      "kind": "repository",
      "status": "stable",
      "title": {
        "ru": "Исходный код",
        "en": "Source code"
      },
      "summary": {
        "ru": "Открытый исходный код фреймворка на GitHub.",
        "en": "The framework's open source code on GitHub."
      },
      "repository": "simai/ui-source",
      "placement": {
        "mode": "external",
        "url": "https://github.com/simai/ui-source"
      }
    },
    {
      "id": "docara-docs",
      "family": "docara",
      "kind": "docs",
      "status": "stable",
      "title": {
        "ru": "Документация Docara",
        "en": "Docara documentation"
      },
      "summary": {
        "ru": "Установка, структура сайта, навигация, локали, компоненты и публикация.",
        "en": "Installation, site structure, navigation, locales, components and publishing."
      },
      "repository": "simai/docara",
      "placement": {
        "mode": "external",
        "url": "https://simai.github.io/docara/",
        "planned": "{locale}/docara/docs/"
      }
    },
    {
      "id": "docara-source",
      "family": "docara",
      "kind": "repository",
      "status": "stable",
      "title": {
        "ru": "Исходный код",
        "en": "Source code"
      },
      "summary": {
        "ru": "Docara на GitHub: релизы, задачи и история изменений.",
        "en": "Docara on GitHub: releases, issues and the change history."
      },
      "repository": "simai/docara",
      "placement": {
        "mode": "external",
        "url": "https://github.com/simai/docara"
      }
    }
  ]
}
